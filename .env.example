# ---------------------------------------------------------------------------
# Supabase — copy to .env.local and fill in from the project's API settings.
# Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_, never expose to the browser.
# Used for admin/teacher account creation and password resets.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supabase MCP + CLI (developer machine only, not needed at runtime on Vercel).
# Personal access token: https://supabase.com/dashboard/account/tokens
# Export these in your shell so .mcp.json can resolve them.
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Protects the keep-alive cron route that stops the free-tier database from
# pausing after ~7 days of inactivity. Any long random string.
# ---------------------------------------------------------------------------
CRON_SECRET=
